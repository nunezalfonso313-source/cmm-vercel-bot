{
  "version": 2,
  "builds": [
    {"src": "index.html", "use": "@vercel/static"},
    {"src": "api/chat.py", "use": "@vercel/python"},
    {"src": "api/index.py", "use": "@vercel/python"}
  ],
  "routes": [
    {"src": "/api/chat", "dest": "/api/chat.py"},
    {"src": "/api/index", "dest": "/api/index.py"},
    {"src": "/", "dest": "/index.html"}
  ]
}
